# GitHub Pages 배포용: 원본 회원가입/로그인 화면을 그대로 쓰되,
# 계정과 세이브는 브라우저 안의 계정 서버(IndexedDB)에 저장한다.
VITE_BYPASS_LOGIN=0
VITE_LOCAL_SERVER=1
VITE_BYPASS_TUTORIAL=0
VITE_SERVER_URL=http://localhost:8001
VITE_I18N_DEBUG=0
# 랭킹 서버(Supabase)는 .env 에 적지 않고, GitHub 저장소의 Actions Variables(SUPABASE_URL, SUPABASE_ANON_KEY)로 넣는다.
# 로컬에서 시험할 때만 이 두 줄을 .env.pages.local 에 적으면 된다. (README 참고)
